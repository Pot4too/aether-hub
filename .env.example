# Copy to .env (gitignored) and adjust:  cp .env.example .env
# scripts/start.sh does this automatically if .env is missing.
# Every value below is the default used by docker-compose.yml, so an
# unchanged copy behaves exactly like having no .env at all.

# Host path for SQLite + mosquitto persistence/logs. Point it at a mounted
# USB drive to keep data off the SD card. Must stay an uncommented
# AETHER_DATA_DIR=... line: scripts/start.sh greps for it.
AETHER_DATA_DIR=./data

# MQTT subscription filter used by ingest.
MQTT_TOPIC_FILTER=sensors/+/data

# Only needed if you turn off allow_anonymous in mosquitto/config/mosquitto.conf.
MQTT_USERNAME=
MQTT_PASSWORD=

# Comma-separated allowed origins for the API. "*" is fine for local dev;
# narrow it before the API is reachable from anywhere untrusted.
CORS_ALLOW_ORIGINS=*

# Applies to both ingest and api (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
